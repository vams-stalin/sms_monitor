# ── Email / Alert Configuration ──────────────────────────────────────────────
# Copy this file to email.env and fill in real values.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com

# For Gmail: use an App Password, NOT your regular password.
# Generate one at: Google Account → Security → 2-Step Verification → App passwords
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# The "From" name shown in alert emails. Must be a single address.
ALERT_FROM=SMS Monitor <your-email@gmail.com>

# Primary recipients — separate multiple addresses with commas.
ALERT_TO=recipient@company.com

# CC recipients — optional, leave blank to disable.
ALERT_CC=
