<?xml version="1.0" encoding="utf-8"?>
<!--
    IIS Configuration for VAMS SMS Monitor (FastAPI + Uvicorn)
    Requires: HttpPlatformHandler installed on IIS

    IMPORTANT: Update processPath below to match Python location on this server.
    Find it by running in CMD:  where python
    Common locations:
      C:\Python311\python.exe
      C:\Python3\python.exe
      C:\Users\<user>\AppData\Local\Programs\Python\Python311\python.exe
-->
<configuration>

  <system.webServer>
    <handlers>
      <add name="PythonHandler"
           path="*"
           verb="*"
           modules="httpPlatformHandler"
           resourceType="Unspecified"/>
    </handlers>

    <!--
        BEFORE DEPLOYING: update processPath to the correct Python on this server.
        To find it, run in CMD:  where python
        Common locations:
          C:\Python311\python.exe
          C:\Python312\python.exe
          C:\Users\<user>\AppData\Local\Programs\Python\Python311\python.exe
    -->
    <httpPlatform processPath="C:\Program Files\Python311\python.exe"
                  arguments="-m uvicorn main:app --host 127.0.0.1 --port %HTTP_PLATFORM_PORT% --workers 1"
                  stdoutLogEnabled="true"
                  stdoutLogFile=".\logs\uvicorn.log"
                  startupTimeLimit="120"
                  requestTimeout="00:04:00">
      <environmentVariables>
        <environmentVariable name="PORT"       value="%HTTP_PLATFORM_PORT%"/>
        <environmentVariable name="PYTHONPATH" value="."/>
      </environmentVariables>
    </httpPlatform>

    <!-- Serve static files directly through IIS for better performance -->
    <staticContent>
      <remove fileExtension=".svg"/>
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml"/>
      <remove fileExtension=".woff2"/>
      <mimeMap fileExtension=".woff2" mimeType="font/woff2"/>
    </staticContent>

  </system.webServer>
</configuration>
