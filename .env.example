JWT_SECRET=replace-with-a-long-random-string
DEFAULT_ADMIN_PASSWORD=replace-with-strong-password

# DEPLOYMENT: always run with a single worker — multiple workers cause duplicate
# scheduled jobs (sync, email, flag-reset). Start with:
#   uvicorn main:app --host 0.0.0.0 --port 8000 --workers 1
# Set FORCE_HTTPS=true and point a reverse-proxy (nginx) at port 8000 for HTTPS.
FORCE_HTTPS=false

DB_SERVER=your-db-server-ip
DB_NAME=your-database-name
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password

# Email settings are in email.env
